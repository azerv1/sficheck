{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ListFile",
  "$defs": {
    "ListFile": {
      "title": "ListFile",
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ListEntry"
          },
          "default": []
        }
      },
      "required": []
    },
    "ListEntry": {
      "title": "ListEntry",
      "description": "One entry of a JSON list (bundled or --blacklist); see README \"Lists\".",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Status",
          "default": "nonfree"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "reference": {
          "type": "string",
          "default": ""
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ring": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ring"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "antifeatures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Antifeature"
          },
          "default": []
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "if": {
        "not": {
          "properties": {
            "status": {
              "const": "free"
            }
          },
          "required": [
            "status"
          ]
        }
      },
      "then": {
        "required": [
          "reference"
        ],
        "properties": {
          "reference": {
            "minLength": 1
          }
        }
      }
    },
    "Status": {
      "title": "Status",
      "enum": [
        "free",
        "nonfree",
        "semifree",
        "unknown",
        "uses-nonfree"
      ]
    },
    "Ring": {
      "title": "Ring",
      "description": "The CPU protection ring a program runs in; lower rings see and control more.\n\nRings 1 and 2 go unused by mainstream OSes. The negative rings are the usual names\nfor what sits below the kernel.",
      "enum": [
        -3,
        -2,
        -1,
        0,
        3
      ]
    },
    "Antifeature": {
      "title": "Antifeature",
      "description": "Why a finding matters beyond its license; F-Droid's anti-features (minus NSFW) plus DRM.\n\nTags never change a status or the Freedom Index.",
      "enum": [
        "ads",
        "disabled-algorithm",
        "drm",
        "known-vuln",
        "no-source-since",
        "nonfree-add",
        "nonfree-assets",
        "nonfree-dep",
        "nonfree-net",
        "tethered-net",
        "tracking",
        "upstream-nonfree"
      ]
    }
  }
}
