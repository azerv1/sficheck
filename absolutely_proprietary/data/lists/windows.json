      "status": "nonfree",
      "alternatives": [
        "Kdenlive",
        "Shotcut",
        "OBS Studio"
      ],
      "description": "Proprietary video software"
    },
    {
      "name": "Notes & productivity",
      "pattern": "^(Notion|Obsidian|Evernote|Todoist|Microsoft To Do|Grammarly)",
      "status": "nonfree",
      "alternatives": [
        "Logseq",
        "Joplin",
        "LanguageTool"
      ],
      "description": "Proprietary productivity app"
    },
    {
      "name": "Design",
      "pattern": "^(Figma|Canva|Sketch|Affinity)",
      "status": "nonfree",
      "alternatives": [
        "Penpot",
        "Inkscape",
        "Krita"
      ],
      "description": "Proprietary design app"
    },
    {
      "name": "Image editors",
      "pattern": "^(Paint\\.NET|paint\\.net|IrfanView|XnView)",
      "status": "nonfree",
      "alternatives": [
        "Krita",
        "GIMP",
        "Pinta"
      ],
      "description": "Proprietary (freeware) image editor"
    },
    {
      "name": "System cleaners",
      "pattern": "^(CCleaner|Revo Uninstaller|IObit|Driver Booster|Advanced SystemCare|Wise (Care|Disk)|Glary)",
      "status": "nonfree",
      "alternatives": [
        "BleachBit"
      ],
      "description": "Proprietary system utility"
    },
    {
      "name": "Freeware utilities",
      "pattern": "^(WinZip|Everything|TreeSize|WizTree|Postman|Snagit|Wondershare|HiSuite|Synology|RealVNC|VNC Viewer|Surge|AnyToISO|PowerISO|UltraISO|Daemon Tools)",
      "status": "nonfree",
      "alternatives": [
        "PeaZip",
        "ShareX",
        "TigerVNC",
        "Bruno",
        "Filelight"
      ],
      "description": "Proprietary utility"
    },
    {
      "name": "Proprietary dev tools",
      "pattern": "^(Liquibase [5-9]|HashiCorp |Claude Code|Cursor|GitKraken|Tower|Navicat|DBeaver (EE|Enterprise)|DataGrip|Beyond Compare|SmartGit)",
      "status": "nonfree",
      "alternatives": [
        "OpenTofu",
        "DBeaver Community",
        "Meld",
        "opencode"
      ],
      "description": "Proprietary or source-available developer tool"
    },
    {
      "name": "VeraCrypt",
      "pattern": "^VeraCrypt",
      "status": "semifree",
      "alternatives": [
        "cryptsetup (on GNU/Linux)"
      ],
      "description": "Apache 2.0 plus the TrueCrypt License 3.0, which is not free"
    },
    {
      "name": "Cloud CLIs",
      "pattern": "^(AWS Command Line Interface|Google Cloud SDK|Azure CLI|Microsoft Azure CLI|vultr-cli|Doctl)",
      "status": "uses-nonfree",
      "description": "Free client for a proprietary cloud service"
    },
    {
      "name": "Free applications",
      "pattern": "^(Git( version|$)|Python \\d|Python Launcher|Node\\.js|Go Programming Language|Rust|rustup|LLVM|CMake|Neovim|Vim |GNU Emacs|Notepad\\+\\+|VLC|OBS Studio|GIMP|Inkscape|Krita|Blender|Audacity|LibreOffice|Thunderbird|KeePassXC|PuTTY|WinSCP|FileZilla|qBittorrent|mpv|HandBrake|ShareX|Rufus|Ventoy|Wireshark|Npcap|MSYS2|Cygwin|Kdenlive|Shotcut|darktable|digiKam|Calibre|Zotero|Syncthing|Nextcloud|Element|Jami|Joplin|Logseq|Tor Browser|Mullvad Browser|PowerShell \\d|Windows Subsystem for Linux|WinMerge|Greenshot|Flameshot|Ollama|Jan|Podman|Rancher Desktop|Strawberry|GnuPG|GNU Privacy Guard|GitHub CLI|Graphviz|ImageMagick|FFmpeg|Poppler|Tesseract-OCR|Universal Ctags|Wget2?|yt-dlp|Clink|AutoHotkey|DB Browser for SQLite|DuckDB|iPerf3|Nmap [1-7]\\.[0-8]|PostgreSQL|PostGIS|PgBouncer|pgAgent|PEM-HTTPD|MySQL|TigerVNC|WezTerm|OpenTofu|Fast Node Manager|Deno|USBPcap|Freenet|Mozilla Maintenance Service|rotki|oneAPI Level Zero|ezwinports|RipGrep|Chafa|MediaInfo|LSDeluxe|Bruno|opencode|Lazydocker|Yazi|(bat|fd|fzf|jq|yq|lf|glow|gping|hyperfine|tokei|scc|procs|Dust|duf|bottom|xh|Just|gitui|act|less|zoxide|csvlens|qrcp|psmux|witr|FileQL|GitQL)$)",
      "status": "free"
    },
    {
      "name": "Microsoft (other)",
      "pattern": "\\bMicrosoft\\b|^Update for .*Windows|\\(KB\\d+\\)|^MSXML|^vs_",
      "status": "nonfree",
      "alternatives": [],
      "description": "Proprietary Microsoft component"
    }
  ]
}
