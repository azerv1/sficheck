{
  "$schema": "../../../docs/lists.schema.json",
  "_comment": "Windows registry programs, matched by regex against DisplayName. First match in file order wins, so put specific patterns before general ones. 'free' entries let the index count known free software. Only used by the 'windows' source; package ids (winget/scoop/choco) use windows-packages.json.",
  "entries": [
    {
      "name": "Microsoft Windows",
      "pattern": "^Microsoft Windows (\\d|Server)",
      "status": "nonfree",
      "ring": 0,
      "alternatives": [
        "Trisquel",
        "Parabola",
        "Guix System"
      ],
      "description": "The operating system itself is proprietary",
      "reference": "https://en.wikipedia.org/wiki/Microsoft_Windows"
    },
    {
      "name": "Visual Studio Code",
      "pattern": "^Microsoft Visual Studio Code",
      "status": "nonfree",
      "alternatives": [
        "VSCodium"
      ],
      "description": "Microsoft's VS Code build is under a proprietary license",
      "reference": "https://en.wikipedia.org/wiki/Visual_Studio_Code"
    },
    {
      "name": "Visual Studio",
      "pattern": "^(Microsoft )?Visual Studio (Community|Professional|Enterprise|Build Tools|Installer)",
      "status": "nonfree",
      "alternatives": [
        "MSYS2/MinGW-w64",
        "LLVM/Clang"
      ],
      "description": "Proprietary IDE/toolchain",
      "reference": "https://en.wikipedia.org/wiki/Visual_Studio"
    },
    {
      "name": "Visual C++ Redistributable",
      "pattern": "^Microsoft Visual C\\+\\+ .*Redistributable",
      "status": "nonfree",
      "description": "Proprietary runtime many programs depend on",
      "reference": "https://en.wikipedia.org/wiki/Microsoft_Visual_C++"
    },
