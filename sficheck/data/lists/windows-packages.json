{
  "$schema": "../../../docs/lists.schema.json",
  "_comment": "Windows package ids (winget, scoop, Chocolatey) whose declared license is missing or misleading. Regexes match the whole id, case-insensitively.",
  "entries": [
    {
      "name": "Visual C++ runtimes",
      "pattern": "^Microsoft\\.(VCRedist|VCLibs)\\.|^vcredist",
      "status": "nonfree",
      "description": "Proprietary Microsoft runtime",
      "reference": "https://en.wikipedia.org/wiki/Microsoft_Visual_C++"
    },
    {
      "name": "SQL Server",
      "pattern": "^Microsoft\\.(msodbcsql|SQLServer|CLRTypesSQLServer)\\b",
      "status": "nonfree",
      "alternatives": [
        "PostgreSQL.PostgreSQL",
        "MariaDB.Server"
      ],
      "description": "Proprietary database and drivers",
      "reference": "https://en.wikipedia.org/wiki/Microsoft_SQL_Server"
    },
    {
      "name": "Visual Studio",
      "pattern": "^Microsoft\\.VisualStudio\\.",
      "status": "nonfree",
      "description": "Proprietary IDE/toolchain",
      "reference": "https://en.wikipedia.org/wiki/Visual_Studio"
    },
    {
      "name": "Microsoft Office",
      "pattern": "^Microsoft\\.(Office|Outlook)\\b",
      "status": "nonfree",
      "alternatives": [
        "TheDocumentFoundation.LibreOffice"
      ],
      "description": "Proprietary office suite",
      "reference": "https://en.wikipedia.org/wiki/Microsoft_Office"
    },
    {
      "name": "WebView2",
      "pattern": "^Microsoft\\.EdgeWebView2Runtime$",
      "status": "nonfree",
      "description": "Proprietary browser runtime",
      "reference": "https://en.wikipedia.org/wiki/Microsoft_Edge"
    },
    {
      "name": "Skype",
      "pattern": "^Microsoft\\.Skype\\b",
      "status": "nonfree",
      "description": "Proprietary VoIP client",
      "reference": "https://en.wikipedia.org/wiki/Skype"
    },
    {
      "name": "Windows updates (choco)",
      "pattern": "^KB\\d+",
      "status": "nonfree",
      "description": "Proprietary Windows update",
      "reference": "https://en.wikipedia.org/wiki/Microsoft_Windows"
    },
    {
      "name": "Ubuntu (WSL)",
      "pattern": "^Canonical\\.Ubuntu",
      "status": "uses-nonfree",
      "alternatives": [
        "Trisquel",
        "Parabola",
        "Guix System"
      ],
      "description": "Not endorsed by the FSF: ships and recommends nonfree software",
      "reference": "https://www.gnu.org/distros/common-distros.html"
    },
    {
      "name": "Liquibase",
      "pattern": "^Liquibase\\.Liquibase$",
      "status": "nonfree",
      "alternatives": [
        "Flyway Community",
        "sqitch"
      ],
      "description": "Functional Source License since 5.0",
      "reference": "https://www.liquibase.com/blog/liquibase-community-for-the-future-fsl"
    },
    {
      "name": "Known free (missing license metadata)",
      "pattern": "^(GitHub\\.cli|Mozilla\\.Thunderbird|Python\\.Python\\.\\d+|shinchiro\\.mpv|MediaArea\\.MediaInfo|Git\\.Git|Neovim\\.Neovim|VideoLAN\\.VLC|PostgreSQL\\.PostgreSQL(\\.\\d+)?|ffmpeg|maven|neovim|tesseract|git|python3?|nodejs(\\.install)?|golang|rust|vlc)$",
      "status": "free"
    }
  ]
}
